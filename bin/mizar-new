#!/bin/sh
set -e

if [ -z "$1" ]; then
    echo "Usage: mizar-new <project-name>"
    exit 1
fi

DIR="$1"

if [ -d "$DIR" ]; then
    echo "Error: Directory '$DIR' already exists."
    exit 1
fi

mkdir -p "$DIR"

# 1. Generate main.c
cat << 'EOF' > "$DIR/main.c"
#include <mizar.h>

static void handle_home(const MzRequest *req, MzResponse *res, void *user_data) {
    (void)req; (void)user_data;
    mz_res_html(res);

    MzPage(&res->body, .title = "My Mizar App", .theme_color = "#0284c7") {
        MzFlashContainer();

        Div(.style = "max-width: 720px; margin: 60px auto; font-family: system-ui, sans-serif; padding: 0 20px;") {
            H1(.style = "color: #0f172a; font-size: 2.25rem; font-weight: 800; margin-bottom: 8px;") {
                Text("Welcome to Mizar + HTMX 4");
            }
            P(.style = "color: #475569; font-size: 1.1rem; line-height: 1.6; margin-bottom: 32px;") {
                Text("A high-performance reactive web application built with modern C23.");
            }

            // Interactive Hypermedia Pattern
            Div(.style = "margin-bottom: 24px;") {
                MzSearch(.url = "/api/search", .target = "#results", .placeholder = "Live search items...");
                Div(.id = "results", .style = "margin-top: 12px;") {}
            }

            // Click-to-Edit Pattern
            MzClickToEdit(.url = "/api/profile/edit", .label = "User Status", .value = "Active Contributor");
        }
    }
}

static void handle_search(const MzRequest *req, MzResponse *res, void *user_data) {
    (void)user_data;
    const char *q = mz_req_query(req, "q");
    mz_res_html(res);
    mz_context_push(&res->body);
    Div(.style = "padding: 12px; background: #f1f5f9; border-radius: 6px; font-size: 0.9rem; color: #334155;") {
        Text("Found results for: %s", q && *q ? q : "(all)");
    }
    mz_context_pop();
}

int main(void) {
    MzApp app;
    mz_app_init(&app);
    mz_app_set_workers(&app, 4);

    // Standard middlewares
    mz_app_use(&app, mz_middleware_security_headers);

    // Routes
    mz_app_get(&app, "/", handle_home);
    mz_app_get(&app, "/api/search", handle_search);

    printf("Mizar application running at http://localhost:3000\n");
    mz_app_listen(&app, 3000);

    mz_app_free(&app);
    return 0;
}
EOF

# 2. Generate Makefile
cat << 'EOF' > "$DIR/Makefile"
CC ?= gcc
CFLAGS ?= -std=c23 -Wall -Wextra -O2 $(shell pkg-config --cflags mizar 2>/dev/null || echo "-I/usr/local/include/mizar -I/usr/include/mizar")
LIBS ?= $(shell pkg-config --libs mizar 2>/dev/null || echo "-lmizar -lpthread")

app: main.c
	$(CC) $(CFLAGS) main.c $(LIBS) -o app

run: app
	./app

clean:
	rm -f app
EOF

# 3. Generate .gitignore
cat << 'EOF' > "$DIR/.gitignore"
app
*.o
*.so
*.a
.DS_Store
EOF

echo "Created new Mizar project in '$DIR'."
echo ""
echo "To get started:"
echo "  cd $DIR"
echo "  make run"
